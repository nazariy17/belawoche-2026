# Optional free adsb.lol key; configure in Vercel environment settings.
# Without a key, provider currently permits 500 requests/day per public IP.
# Local: set this in the terminal environment before starting uvicorn.
ADSB_LOL_API_KEY=
# Optional departure/destination lookup; requires an aviationstack account/plan
# allowing HTTPS flight lookups and your intended display usage. Server only.
AVIATIONSTACK_API_KEY=
